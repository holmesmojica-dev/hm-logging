<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>

		<Version>0.1.0-preview.1</Version>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>

		<PackageId>Hm.Logging</PackageId>
		<Authors>Holmes Mojica</Authors>
		<Company>Holmes Mojica Dev</Company>

		<Description>
			Structured logging library for modern .NET applications featuring immutable log processing, distributed tracing integration, nested scope propagation, provider isolation, and resilient multi-provider orchestration.
		</Description>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup>
		<RepositoryUrl>https://github.com/holmesmojica-dev/hm-logging</RepositoryUrl>
		<PackageProjectUrl>https://github.com/holmesmojica-dev/hm-logging</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>logging;structured-logging;observability;tracing;microservices;dotnet</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>Initial prerelease version.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	
	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md"
			  Pack="true"
			  PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\icon.png"
			  Pack="true"
			  PackagePath="\" />
	</ItemGroup>

</Project>

